projection;
strict ( 2 );
use draft;

define behavior for zc_ses_parent alias Parent
{
  use create;
  use update;
  use delete;

  field ( readonly ) status , Local_Last_Changed_At ;
  use action Edit;
  use action Activate;
  use action Discard;
  use action Resume;
  use action Prepare;
  use association _ses_excel { create; with draft; }
}

define behavior for zc_ses_excel alias Child
{
  use update;
  use delete;
  use association _ses_file { with draft; }
  use action createSES;
}