projection;
strict ( 2 );
use draft;
define behavior for ZC_USER_UPLOAD alias File
use etag

{
  use create;
  use update;
  use delete;

  use action Edit;
  use action Activate;
  use action Discard;
  use action Resume;
  use action Prepare;

  use association _dataFile { create; with draft; }

}

define behavior for ZC_USR_DATA_FILE alias dataFile
use etag
{

  use update;
  use delete;

  use association _File { with draft; }

}

