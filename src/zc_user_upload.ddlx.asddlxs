@Metadata.layer: #CORE
@UI: {
  headerInfo: {
    typeName: 'Upload Files',
    typeNamePlural: 'Upload Files'
  }
}
annotate view ZC_USER_UPLOAD with
{

  @UI.facet: [{ id:            'File',
                purpose:       #STANDARD,
                type:          #IDENTIFICATION_REFERENCE,
                label:         'File',
                position:      10 },
              { id:            'Preview',
                purpose:       #STANDARD,
                type:          #LINEITEM_REFERENCE,
                label:         'Preview',
                position:      20,
                targetElement: '_previewData'}]

  @UI.hidden: true

//  @UI: { lineItem:       [ { position: 10, importance: #HIGH },
//                         { type: #FOR_ACTION, dataAction: 'Preview', label: 'Preview Data' } ],
//       identification: [ { position: 10, label: 'File Id' },
//                         { type: #FOR_ACTION, dataAction: 'Preview', label: 'Preview Data' } ],
//       selectionField: [ { position: 10 } ] }


  Uuid;

  @UI.lineItem: [ {
    position: 10 ,
    importance: #MEDIUM
  } ]
  @UI.identification: [ {
    position: 10
  } ]
  EndUser;

  @UI.lineItem: [ {
    position: 20 ,
    importance: #MEDIUM
  } ]
  @UI.identification: [ {
    position: 20
  } ]
  @EndUserText.label: 'Count'
  ZCount;

  @UI.lineItem: [ {
    position: 30 ,
    importance: #MEDIUM,
    label: 'Status'
  } ]
  @UI.identification: [ {
    position: 30 ,
    label: 'Status'
  } ]
  @UI.textArrangement: #TEXT_FIRST
  @UI.hidden: true
  Status;

  @UI.lineItem: [ {
    position: 40 ,
    importance: #MEDIUM
  } ]
  @UI.identification: [ {
    position: 40
  } ]
  Attachment;

  @UI.lineItem: [ {
    position: 50 ,
    importance: #MEDIUM
  } ]
  @UI.identification: [ {
    position: 50
  } ]
  @UI.hidden: true
  Mimetype;

  @UI.lineItem: [ {
    position: 60 ,
    importance: #MEDIUM
  } ]
  @UI.identification: [ {
    position: 60
  } ]
  Filename;

  @UI.lineItem: [ {
    position: 70 ,
    importance: #MEDIUM
  } ]
  @UI.identification: [ {
    position: 70
  } ]
  @EndUserText.label: 'Last change At'
  LocalLastChangedAt;
}